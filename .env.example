# Hostline Text V1 defaults to a safe, no-network simulation mode.
SIMULATION=true

# Supabase (server-side values; do not expose SERVICE_ROLE to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Required only when SIMULATION=false
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-auth-token
TWILIO_PHONE_NUMBER=+15555550100
TWILIO_WEBHOOK_BASE_URL=https://hostline.example.com
